{
  "expo": {
    "name": "CODEQUESTHUB",
    "slug": "codequest-hub",
    "owner": "brobbeydev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.codequest-hub"
    },
    "android": {
      "package": "com.brobbeydev.codequesthub",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CodeQuestHub to access your photos to upload a showcase image."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "https://gateway-service-j9ql.onrender.com",
      "eas": {
        "projectId": "260bc8a0-2a9a-4f69-a902-f0743401b578"
      }
    }
  }
}
