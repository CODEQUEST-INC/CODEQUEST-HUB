# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file.

# Used by docker-compose.yml to pass a JWT signing secret into every service.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev_only_change_me

# Only needed if you run a service OUTSIDE docker compose (e.g. via `npm run dev`
# directly on your machine while Postgres still runs in Docker).
DATABASE_URL=postgresql://codequest:codequest_dev_pw@localhost:5432/codequesthub
