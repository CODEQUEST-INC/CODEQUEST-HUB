# Neon PostgreSQL — include ?sslmode=require&stringtype=unspecified
# (stringtype=unspecified is required so the pgjdbc driver lets Postgres cast
# enum-typed columns like user_role/proposal_status instead of rejecting them
# as character varying)
DB_URL="jdbc:postgresql://<neon-host>/<dbname>?sslmode=require&stringtype=unspecified"
DB_USERNAME=<your-neon-username>
DB_PASSWORD=<your-neon-password>

# Must be at least 32 chars for HMAC-SHA256
JWT_SECRET=changeme_changeme_changeme_changeme

# Paystack sandbox secret key (Settings > API Keys & Webhooks in the Paystack dashboard)
PAYSTACK_SECRET_KEY=sk_test_changeme

# Brevo SMTP relay (Settings > SMTP & API > SMTP tab in the Brevo dashboard)
SMTP_USERNAME=<your-brevo-smtp-login>
SMTP_PASSWORD=<your-brevo-smtp-key>

# Cloudflare R2 (S3-compatible object storage) — R2 > Manage API Tokens in the Cloudflare dashboard
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET=<your-r2-bucket-name>
